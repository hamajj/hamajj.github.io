# Public GitHub profile used by the build-time sync script.
GITHUB_USERNAME=hamajj

# Required for the real contribution graph. Without it, the sync script falls
# back to public events, which does not match GitHub's profile contribution calendar.
GITHUB_TOKEN=

# Keep this true on Vercel if you want the live Spotify widget.
NUXT_PUBLIC_ENABLE_NOW_PLAYING=true

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
